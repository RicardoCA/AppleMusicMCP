# Copie este arquivo para .env e preencha com seus dados

# === Apple Developer Credentials ===
# Obtenha em: https://developer.apple.com > Certificates, Identifiers & Profiles > Keys
APPLE_TEAM_ID=SEU_TEAM_ID_AQUI
APPLE_KEY_ID=SUA_KEY_ID_AQUI
APPLE_PRIVATE_KEY_PATH=./AuthKey.p8

# Se preferir colar o conteudo da chave diretamente (alternativa ao path):
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# === Music User Token ===
# Execute: node scripts/auth.js
# Ou obtenha manualmente (veja README para instrucoes)
APPLE_MUSIC_USER_TOKEN=SEU_MUSIC_USER_TOKEN_AQUI
